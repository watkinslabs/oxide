#!/usr/bin/env bash
# pre-push: two gates, both keyed on whether the outgoing commits touch a
# kernel / arch / ABI / userspace surface.
#
#   1. hosted-gate (EVERY push, branch or main): type-check every workspace
#      crate on its own for the host. Nothing else in the routine set builds a
#      crate with only ITS OWN default features — `cargo test` turns the
#      `hosted` gate on through `cfg(test)`, both kernel builds turn it on
#      through `target_os`, and `cargo check --workspace` turns it on through
#      feature unification with a dependant. B1660 reached main red for
#      `cargo check -p net` with all of them green.
#      Bypass: SKIP_HOSTED_GATE=1.
#   1b. test-build-gate (EVERY push that touches those surfaces): BUILD every
#      crate's test targets on its own. `cargo check -p <crate>` compiles no
#      test targets at all, so gate 1 is silent about `#[cfg(test)]` trees,
#      `tests/` directories and dev-dependencies. `cargo test -p procfs` did
#      not build on main; its 155 tests only ever ran under `--workspace`,
#      where a sibling's dev-dependency unified `sched/hosted` on.
#      Bypass: SKIP_TEST_BUILD_GATE=1.
#   2. feature-gate (EVERY push, branch or main): type-check both arches with
#      `--features debug-all`. Nothing else in the routine set compiles
#      feature-gated code, so a compile error inside `debug_boot! { … }` or any
#      `#[cfg(feature = …)]` block survives a green local run and a green
#      `xtask kernel`, then kills `make qemu-*` before QEMU starts — an empty
#      boot log that reads like a boot failure. B1641 lost a lane to that.
#      Bypass: SKIP_FEATURE_GATE=1.
#   2b. frame-gate + stack-gate (EVERY push that touches those surfaces): no
#      single frame >= 8 KiB, no static call path >= 13 KiB of the 16 KiB
#      kernel stack. Both gates existed only inside a workflow that has taken
#      no automatic trigger since 2026-07-04, and nothing local ran them, so
#      both sat RED on main while every routine gate stayed green — that is how
#      an 8192 B lock array reached per-namespace state and put the softirq
#      receive path 2.5 KiB from the guard page.
#      Bypass: SKIP_STACK_GATE=1.
#   3. lint-ratchet (EVERY push, branch or main, ~0.8 s): spec-lint findings may
#      not grow per (crate, rule). `make lint` itself reports a 2696-finding
#      backlog and so gates nothing; `make ci` included it and was therefore
#      unconditionally red and unread, which is how the backlog grew unnoticed.
#      Bypass: SKIP_LINT_RATCHET=1.
#   4. boot-smoke (direct main pushes only): capped at 180 seconds per arch.
#      Bypass: SKIP_SMOKE=1.
#
# Documentation-only, CI-only, and tooling-only pushes trigger neither.
#
# Install once per clone:
#   git config core.hooksPath .githooks
set -uo pipefail

# Read pushed refs from stdin (git's pre-push protocol).
remote_ref_lines="$(cat)"

# Feature branches are reviewed and merged through GitHub; they must not
# hold publication behind a local QEMU run. A direct main push retains the
# local boot gate. A multi-ref push containing main is treated as a main
# push, because it changes the protected integration branch.
pushes_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    if [ "$remote_ref" = "refs/heads/main" ]; then
        pushes_main=1
        break
    fi
done <<< "$remote_ref_lines"

# Collect every commit being pushed.
shas=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch — diff against main.
        range="origin/main..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    shas="$shas $(git rev-list "$range" 2>/dev/null)"
done <<< "$remote_ref_lines"

if [ -z "${shas// /}" ]; then
    exit 0
fi

# Files changed across all pushed commits. `git diff --name-only
# $SHA` would compare working tree to $SHA (empty after a clean
# commit); `git show --name-only --format=` lists exactly the
# files each commit modified.
changed="$(git show --name-only --format= $shas 2>/dev/null | sort -u | grep -v '^$')"
if [ -z "$changed" ]; then
    exit 0
fi

# ---- gate 0: spec-lint findings may not grow ------------------------------
# Runs on EVERY push including doc-only ones: the ratchet covers the doc, xref
# and manifest lints too, and it costs under a second.
if [ "${SKIP_LINT_RATCHET:-0}" = "1" ]; then
    echo "pre-push: SKIP_LINT_RATCHET=1 set, bypassing lint-ratchet"
else
    if ! make lint-ratchet; then
        echo "pre-push: FAIL — spec-lint findings grew (make lint-ratchet)" >&2
        echo "         the baseline is a ratchet, not a waiver list: fix the new finding," >&2
        echo "         do not raise the count. SKIP_LINT_RATCHET=1 to bypass." >&2
        exit 1
    fi
fi

# Trigger paths — anything that can break the build or the boot. Pure-doc,
# pure-CI, and pure-tooling changes skip.
need_gate=0
while read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        # crates/drivers/* matters too: virtio-net/blk/gpu/input/etc.
        # are part of the boot path; a regression there breaks the
        # same way a kernel-side regression does.
        # tools/xtask/* builds the rootfs (l2_deps staging, main.rs, the
        # rcS oxide-smokes asset) — a change there alters the booted image,
        # so it must gate too (F349 pushed un-gated otherwise).
        kernel/*|crates/*|userspace/*|targets/*|vendor/*|tools/xtask/*|rust-toolchain.toml|Cargo.toml|Cargo.lock)
            need_gate=1
            break
            ;;
    esac
done <<< "$changed"

if [ "$need_gate" = "0" ]; then
    echo "pre-push: no kernel/userspace/arch changes — skipping feature-gate and boot-smoke"
    exit 0
fi

# ---- gate 1: every crate type-checks on its own, for the host -------------
if [ "${SKIP_HOSTED_GATE:-0}" = "1" ]; then
    echo "pre-push: SKIP_HOSTED_GATE=1 set, bypassing hosted-gate"
else
    echo "pre-push: kernel change — running hosted-gate (per-crate host check)"
    if ! make hosted-gate; then
        echo "pre-push: FAIL — a crate does not type-check on its own (make hosted-gate)" >&2
        echo "         push aborted; fix the gating or SKIP_HOSTED_GATE=1 to bypass" >&2
        exit 1
    fi
fi

# ---- gate 1b: every crate's TEST targets build on their own ---------------
# `cargo check -p <crate>` compiles no test targets, so gate 1 says nothing
# about whether `cargo test -p <crate>` builds. `cargo test -p procfs` did not
# build at all on main and its 155 tests only ran under `--workspace`, where a
# sibling's dev-dependency unified `sched/hosted` on. Every routine gate was
# green throughout.
if [ "${SKIP_TEST_BUILD_GATE:-0}" = "1" ]; then
    echo "pre-push: SKIP_TEST_BUILD_GATE=1 set, bypassing test-build-gate"
else
    echo "pre-push: kernel change — running test-build-gate (per-crate cargo test --no-run)"
    if ! make test-build-gate; then
        echo "pre-push: FAIL — a crate's test targets do not build on their own" >&2
        echo "         (make test-build-gate); its tests run only under feature" >&2
        echo "         unification. Fix the crate's own features/deps, or" >&2
        echo "         SKIP_TEST_BUILD_GATE=1 to bypass." >&2
        exit 1
    fi
fi

# ---- gate 2: feature-gated compile, both arches ---------------------------
if [ "${SKIP_FEATURE_GATE:-0}" = "1" ]; then
    echo "pre-push: SKIP_FEATURE_GATE=1 set, bypassing feature-gate"
else
    echo "pre-push: kernel change — running feature-gate (debug-all check, both arches)"
    if ! make feature-gate; then
        echo "pre-push: FAIL — feature-gated code does not compile (make feature-gate)" >&2
        echo "         push aborted; fix the build or SKIP_FEATURE_GATE=1 to bypass" >&2
        exit 1
    fi
    echo "pre-push: feature-gate PASS on both arches"
fi

# ---- gate 2b: kernel stack budget, both arches ----------------------------
# frame-gate: no single frame may reserve >= 8 KiB. stack-gate: no static call
# path may reach 13 KiB of the 16 KiB kernel stack.
#
# Both existed for weeks inside a workflow that has taken no automatic trigger
# since 2026-07-04, and nothing local ran them, so both sat RED on main while
# every routine gate stayed green. What got through: an 8192 B lock array
# inlined into per-namespace state, giving a function reachable from softirq
# receive a 9256 B frame and putting the worst interrupt-reachable path 2.5 KiB
# from the guard page — the intermittent serial double fault. A per-function
# ceiling cannot catch a chain that sums, and a type-check cannot see a frame
# at all; only these two, on a linked ELF, can.
#
# The builds they depend on are the same release kernels `make build` produces,
# so this is a rebuild only when the push actually changed kernel code.
# Bypass: SKIP_STACK_GATE=1.
if [ "${SKIP_STACK_GATE:-0}" = "1" ]; then
    echo "pre-push: SKIP_STACK_GATE=1 set, bypassing frame-gate/stack-gate"
else
    echo "pre-push: kernel change — running frame-gate + stack-gate (both arches)"
    if ! make -j2 frame-gate stack-gate; then
        echo "pre-push: FAIL — a stack frame or call path is over budget" >&2
        echo "         (make frame-gate stack-gate). Split the chain so the big" >&2
        echo "         frames overlap instead of summing, or move the data" >&2
        echo "         off-stack. An allowlist entry is permission for the" >&2
        echo "         defect, not a fix. SKIP_STACK_GATE=1 to bypass." >&2
        exit 1
    fi
    echo "pre-push: stack budget PASS on both arches"
fi

# ---- gate 3: boot-smoke, direct main pushes only --------------------------
if [ "$pushes_main" = "0" ]; then
    echo "pre-push: PR branch push — skipping boot-smoke"
    exit 0
fi

if [ "${SKIP_SMOKE:-0}" = "1" ]; then
    echo "pre-push: SKIP_SMOKE=1 set, bypassing boot-smoke"
    exit 0
fi

echo "pre-push: direct main kernel push — running bounded boot-smoke"
smoke_log_dir="/tmp/oxide-pre-push-smoke-$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$smoke_log_dir" 2>/dev/null || smoke_log_dir=""
for arch in x86 arm; do
    if ! SMOKE_KEEP_LOG_DIR="$smoke_log_dir" make "smoke-$arch" SMOKE_TIMEOUT="${SMOKE_TIMEOUT:-180}"; then
        echo "pre-push: FAIL — make smoke-$arch did not reach login" >&2
        [ -n "$smoke_log_dir" ] && echo "         preserved smoke logs: $smoke_log_dir" >&2
        echo "         push aborted; fix the boot regression or SKIP_SMOKE=1 to bypass" >&2
        exit 1
    fi
done
echo "pre-push: boot-smoke PASS on both arches"
