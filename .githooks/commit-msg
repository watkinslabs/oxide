#!/usr/bin/env bash
# Reject any AI / tool attribution in commit messages.
#
# CLAUDE.md (Never list): "Add Co-Authored-By: trailer of any kind to any
# commit, ever." Author is the human committer; period. No AI attribution
# trailers, no "Generated with" footers, no 🤖 marker. This hook enforces
# that at commit time so it can never reach history again. Installed via
# `git config core.hooksPath .githooks`.
set -u

msg_file="$1"
# Strip comment lines (git's scissors/comments) before scanning.
body="$(grep -v '^#' "$msg_file" 2>/dev/null || cat "$msg_file")"

# Forbidden patterns (case-insensitive). Each is a distinct attribution vector.
# Covers every AI/tool co-author + "generated/assisted by" footer, and the
# named assistants (Claude, GitHub Copilot, OpenAI Codex/ChatGPT/GPT).
# `co-authored-by:` alone already catches any AI co-author trailer; the named
# entries also catch free-text mentions in footers.
patterns=(
  'co-authored-by:'
  'co-developed-with'
  'assisted-by:'
  'generated with'
  'generated by'
  'written by .*(ai|assistant|bot)'
  # Anthropic / Claude
  'noreply@anthropic'
  'anthropic\.com'
  'claude\.ai'
  'claude code'
  'claude opus'
  'claude sonnet'
  # GitHub Copilot
  'github copilot'
  'copilot'
  'copilot\[bot\]'
  # OpenAI / Codex / ChatGPT
  'openai'
  'codex'
  'chatgpt'
  'gpt-[0-9]'
)

violation=""
while IFS= read -r line; do
  for p in "${patterns[@]}"; do
    if printf '%s' "$line" | grep -qiE "$p"; then
      violation="$line"
      break 2
    fi
  done
done <<< "$body"

# The 🤖 robot emoji (U+1F916) — match its UTF-8 byte sequence explicitly.
if printf '%s' "$body" | grep -qaP '\xf0\x9f\xa4\x96' 2>/dev/null; then
  violation="<robot emoji>"
fi

if [ -n "$violation" ]; then
  cat >&2 <<EOF
commit-msg: REJECTED — AI/tool attribution is forbidden in commit messages.
  offending: ${violation}
CLAUDE.md bans Co-Authored-By trailers, "Generated with ..." footers, the 🤖
marker, and any AI/Anthropic attribution. Author = the human committer only.
Remove the line and re-commit.
EOF
  exit 1
fi

exit 0
