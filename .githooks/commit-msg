#!/usr/bin/env bash
# Reject any AI / tool attribution in commit messages.
#
# CLAUDE.md (Never list): "Add Co-Authored-By: trailer of any kind to any
# commit, ever." Author is the human committer; period. No AI attribution
# trailers, no "Generated with" footers, no 🤖 marker. This hook enforces
# that at commit time so it can never reach history again. Installed via
# `git config core.hooksPath .githooks`.
#
# The patterns themselves live in tools/check-ai-attribution.sh, which the
# pull-request workflow runs as well. A hook is skipped by --no-verify or a
# redirected core.hooksPath, so it is the fast local half of the check, never
# the whole of it; both halves must read the same list or they will disagree.
set -u

# A failed `git add <valid-path> <stale-path>` can leave only part of the
# intended change in the index. Refuse that commit shape: every tracked edit
# and every untracked file must be accounted for before the message is checked.
if ! git diff --quiet --; then
  echo "commit-msg: REJECTED — tracked worktree edits remain unstaged." >&2
  echo "  A partial index can publish an incomplete change after a stale pathspec." >&2
  exit 1
fi
if [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "commit-msg: REJECTED — untracked files remain outside the index." >&2
  echo "  Stage or remove every file before committing." >&2
  exit 1
fi

msg_file="$1"
repo=$(git rev-parse --show-toplevel)
exec "$repo/tools/check-ai-attribution.sh" --message-file "$msg_file"
