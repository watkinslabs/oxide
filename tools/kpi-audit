def repo_root(start: Path) -> Path:
    p = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=start,
                       text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode != 0:
        raise SystemExit(p.stderr.strip() or "not inside a git repository")
    return Path(p.stdout.strip())


def normalize_symbol(sym: str) -> str:
    return VERSION_RE.sub("", sym.strip())


def parse_nm_text(text: str, source: str) -> list[Undef]:
    out: list[Undef] = []
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        m = NM_UNDEF_RE.match(line)
        if not m:
            continue
        sym = normalize_symbol(m.group("sym"))
        if sym:
            out.append(Undef(source, sym, m.group("kind")))
    return out


def run_nm(path: Path, nm: str) -> list[Undef]:
    p = subprocess.run([nm, "-u", str(path)], text=True, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE)
    if p.returncode != 0:
        raise SystemExit(f"{path}: nm failed: {p.stderr.strip()}")
    return parse_nm_text(p.stdout, str(path))


def run_nm_compressed(path: Path, nm: str) -> list[Undef]:
    if path.name.endswith(".ko.xz"):
        cmd = ["xz", "-dc", str(path)]
    elif path.name.endswith(".ko.zst"):
        cmd = ["zstd", "-dcq", str(path)]
    else:
        raise SystemExit(f"{path}: unsupported compressed module")
    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode != 0:
        raise SystemExit(f"{path}: decompression failed: {p.stderr.decode(errors='replace').strip()}")
    with tempfile.NamedTemporaryFile(suffix=".ko") as f:
        f.write(p.stdout)
        f.flush()
        rows = run_nm(Path(f.name), nm)
    return [Undef(str(path), r.symbol, r.kind) for r in rows]


def read_symbols(path: Path) -> list[str]:
    return [normalize_symbol(line) for line in path.read_text().splitlines()
            if line.strip() and not line.lstrip().startswith("#")]


def scan_exports(root: Path, extra: list[Path]) -> set[str]:
    exports: set[str] = set()
    for src in (root / "crates/kernel/modules/src").rglob("*.rs"):
        if src.name == "tests.rs" or "/tests/" in src.as_posix():
            continue
        text = src.read_text()
        for match in EXPORT_RE.finditer(text):
            exports.add(match.group(1))
        for match in EXPORT_TUPLE_RE.finditer(text):
            exports.add(match.group(1))
    for path in extra:
        exports.update(read_symbols(path))
    return exports


def btf_types(path: Path, detail_types: frozenset[str] = BTF_DETAIL_TYPES) -> dict[str, AbiType]:
    raw = path.read_bytes()
    if len(raw) < 24:
        raise ValueError("BTF header is truncated")
    magic, version, flags, hdr_len, type_off, type_len, str_off, str_len = struct.unpack_from("<HBBIIIII", raw)
    if magic != 0xEB9F or version != 1 or flags != 0:
        raise ValueError("unsupported BTF header")
    type_start = hdr_len + type_off
    str_start = hdr_len + str_off
    type_end = type_start + type_len
    str_end = str_start + str_len
    if hdr_len < 24 or type_end > len(raw) or str_end > len(raw):
        raise ValueError("BTF section bounds are invalid")
    types = raw[type_start:type_end]
    strings = raw[str_start:str_end]

    def string(offset: int) -> str:
        if offset == 0:
            return ""
        if offset >= len(strings):
            raise ValueError("BTF string offset is invalid")
        end = strings.find(b"\0", offset)
        if end < 0:
            raise ValueError("BTF string is unterminated")
        return strings[offset:end].decode(errors="replace")

    fixed_size = {BTF_KIND_INT: 4, BTF_KIND_ARRAY: 12, BTF_KIND_VAR: 4,
                  BTF_KIND_DECL_TAG: 4}
    variable_size = {BTF_KIND_ENUM: 8, BTF_KIND_FUNC_PROTO: 8,
                     BTF_KIND_DATASEC: 12, BTF_KIND_ENUM64: 12}
    no_extra = {0, 2, 7, 8, 9, 10, 11, 12, 16, 18}
    found: dict[str, AbiType] = {}
    offset = 0
    while offset < len(types):
        if offset + 12 > len(types):
            raise ValueError("BTF type record is truncated")
        name_off, info, size = struct.unpack_from("<III", types, offset)
        offset += 12
        kind = (info >> 24) & 0x7F
        vlen = info & 0x00FF_FFFF
        name = string(name_off)
        if kind in (BTF_KIND_STRUCT, BTF_KIND_UNION):
            total = vlen * 12
            if offset + total > len(types):
                raise ValueError("BTF member records are truncated")
            members: list[tuple[str, int]] = []
            for _ in range(vlen):
                member_name, _member_type, member_offset = struct.unpack_from("<III", types, offset)
                offset += 12
                members.append((string(member_name), member_offset & 0x00FF_FFFF))
            if kind == BTF_KIND_STRUCT and name in detail_types:
                found[name] = AbiType(name, size, tuple(members))
            continue
        if kind in fixed_size:
            extra = fixed_size[kind]
        elif kind in variable_size:
            extra = vlen * variable_size[kind]
        elif kind in no_extra:
            extra = 0
        else:
            raise ValueError(f"unsupported BTF kind {kind}")
        if offset + extra > len(types):
            raise ValueError("BTF type payload is truncated")
        offset += extra
    return found


def abi_rows(path: Path) -> list[tuple[str, str, str, str, tuple[str, ...]]]:
    host = btf_types(path)
    rows: list[tuple[str, str, str, str, tuple[str, ...]]] = []
    for name in ABI_TYPES:
        supported = SUPPORTED_KPI_ABI.get(name)
        actual = host.get(name)
        if supported is None:
            rows.append((name, "not profiled", str(actual.size) if actual else "absent", "MISSING-PROFILE", ()))
            continue
        if actual is None:
            rows.append((name, str(supported.size), "absent", "HOST-ABSENT", ()))
            continue
        expected_members = dict(supported.members)
        host_members = dict(actual.members)
        details = tuple(
            f"{member}: Oxide +{offset:#x}, host "
            f"{('+' + format(host_members[member] // 8, '#x')) if member in host_members else 'absent'}"
            for member, offset in supported.members
            if host_members.get(member) != offset * 8
        )
        members_match = not details
        if actual.size != supported.size or not members_match:
            status = "MISMATCH"
        elif not expected_members:
            status = "UNVERIFIED-FIELDS"
        else:
            status = "MATCH-PINNED"
        rows.append((name, str(supported.size), str(actual.size), status, details))
    return rows


def print_abi(path: Path) -> bool:
    rows = abi_rows(path)
    print(f"host BTF: {path}")
    print("| Type | Oxide KPI bytes | Host bytes | ABI status |")
    print("| --- | ---: | ---: | --- |")
    for name, supported, actual, status, details in rows:
        print(f"| `{name}` | {supported} | {actual} | {status} |")
        for detail in details:
            print(f"|  |  |  | {detail} |")
    print()
    return all(status == "MATCH-PINNED" for _name, _supported, _actual, status, _details in rows)


def print_btf_types(path: Path, names: list[str]) -> bool:
    types = btf_types(path, frozenset(names))
    ok = True
    for name in names:
        actual = types.get(name)
        if actual is None:
            print(f"{name}: absent")
            ok = False
            continue
        print(f"{name}: {actual.size} bytes")
        for member, offset in actual.members:
            print(f"  {member}: +{offset // 8:#x}")
    return ok


def category(sym: str) -> str:
    for name, needles in CATEGORY_RULES:
        if any(sym == n or sym.startswith(n) or n in sym for n in needles):
            return name
    return "unknown"


def findings(undefs: list[Undef], exports: set[str]) -> list[Finding]:
    by_sym: dict[str, list[Undef]] = {}
    for u in undefs:
        by_sym.setdefault(u.symbol, []).append(u)
    rows: list[Finding] = []
    for sym, refs in by_sym.items():
        status = "EXPORTED" if sym in exports else "WEAK-MISSING" if all(r.kind in "Ww" for r in refs) else "MISSING"
        rows.append(Finding(sym, status, category(sym),
                            tuple(sorted({r.source for r in refs})), len(refs)))
    return sorted(rows, key=lambda r: (r.status != "MISSING", r.category, r.symbol))


def print_summary(rows: list[Finding], exports: set[str]) -> None:
    total = sum(r.refs for r in rows)
    missing = sum(1 for r in rows if r.status == "MISSING")
    weak = sum(1 for r in rows if r.status == "WEAK-MISSING")
    exported = sum(1 for r in rows if r.status == "EXPORTED")
    print(f"exports: {len(exports)}")
    print(f"undefined refs: {total}")
    print(f"unique symbols: {len(rows)}")
    print(f"missing: {missing}")
    print(f"weak-missing: {weak}")
    print(f"exported: {exported}")
    print()


def print_markdown(rows: list[Finding]) -> None:
    print("| Status | Category | Symbol | Refs | Sources |")
    print("| --- | --- | --- | ---: | --- |")
    for r in rows:
        srcs = ", ".join(r.sources)
        print(f"| {r.status} | {r.category} | `{r.symbol}` | {r.refs} | {srcs} |")


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="Audit Linux .ko undefined symbols against Oxide KPI exports.")
    ap.add_argument("inputs", nargs="+", help=".ko files, nm -u text files, or '-' for stdin")
    ap.add_argument("--root", type=Path, default=None, help="repo root; default git top-level")
    ap.add_argument("--nm", default="nm", help="nm binary to run for .ko inputs")
    ap.add_argument("--nm-output", action="store_true", help="treat all inputs as captured nm -u text")
    ap.add_argument("--exports", action="append", type=Path, default=[], help="extra newline-delimited exported symbols")
    ap.add_argument("--fail-on-missing", action="store_true", help="exit 1 when strong missing symbols remain")
    ap.add_argument("--host-btf", type=Path, help="running-kernel BTF to compare with the pinned Oxide KPI profile")
    ap.add_argument("--fail-on-abi-mismatch", action="store_true", help="exit 1 when --host-btf differs from the supported KPI profile")
    ap.add_argument("--inspect-btf-type", action="append", default=[], metavar="NAME", help="print exact struct size and member offsets from --host-btf")
    args = ap.parse_args(argv)

    root = args.root or repo_root(Path.cwd())
    exports = scan_exports(root, args.exports)
    undefs: list[Undef] = []
    for item in args.inputs:
        if item == "-":
            undefs.extend(parse_nm_text(sys.stdin.read(), "stdin"))
            continue
        path = Path(item)
        if args.nm_output:
            undefs.extend(parse_nm_text(path.read_text(), str(path)))
        elif path.suffix == ".ko":
            undefs.extend(run_nm(path, args.nm))
        elif path.name.endswith((".ko.xz", ".ko.zst")):
            undefs.extend(run_nm_compressed(path, args.nm))
        else:
            undefs.extend(parse_nm_text(path.read_text(), str(path)))

    rows = findings(undefs, exports)
    print_summary(rows, exports)
    print_markdown(rows)
    abi_ok = True
    if args.host_btf:
        try:
            abi_ok = print_abi(args.host_btf)
            if args.inspect_btf_type:
                abi_ok = print_btf_types(args.host_btf, args.inspect_btf_type) and abi_ok
        except (OSError, ValueError) as exc:
            raise SystemExit(f"{args.host_btf}: BTF parse failed: {exc}")
    if args.fail_on_missing and any(r.status == "MISSING" for r in rows):
        return 1
    if args.fail_on_abi_mismatch and not abi_ok:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
