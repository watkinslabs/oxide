EXPORT_RE = re.compile(r'\bexport(?:_module)?\(\s*"([^"]+)"')
EXPORT_TUPLE_RE = re.compile(r'\("([^"]+)"\s*,[^)]*as \*const \(\) as usize\)')
NM_UNDEF_RE = re.compile(r"^(?:(?P<addr>[0-9A-Fa-f]+|\s+)\s+)?(?P<kind>[UuWw])\s+(?P<sym>\S+)")
VERSION_RE = re.compile(r"(@@?|#).*$")


@dataclass(frozen=True)
class Undef:
    source: str
    symbol: str
    kind: str


@dataclass(frozen=True)
class Finding:
    symbol: str
    status: str
    category: str
    sources: tuple[str, ...]
    refs: int


@dataclass(frozen=True)
class AbiType:
    name: str
    size: int
    members: tuple[tuple[str, int], ...]


