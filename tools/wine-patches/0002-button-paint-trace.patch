+    INT copied = buffer ? NtUserInternalGetWindowText( hwnd, buffer, len + 1 ) : -1;
+    if (button_trace_ready())
+        WINE_MESSAGE("[WINDOWS-BUTTON] hwnd=%p step=caption buffer=%p copied=%d text=%s\n",
+                     hwnd, buffer, copied, debugstr_wn(buffer, copied > 0 && copied <= len ? copied : 0));
     return buffer;
 }
 
