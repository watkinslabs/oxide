@@ -45,6 +45,18 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(button);
 
+/* Bounded control-paint diagnostics, including paths that submit no glyphs. */
+#define BUTTON_TRACE_LIMIT 256
+static BOOL button_trace_ready(void)
+{
+#ifdef OXIDE_WINE_DIAGNOSTICS
+    static LONG count;
+    return InterlockedIncrement( &count ) <= BUTTON_TRACE_LIMIT;
+#else
+    return FALSE;
+#endif
+}
+
 /* GetWindowLong offsets for window extra information */
 #define STATE_GWL_OFFSET  0
 #define HFONT_GWL_OFFSET  (sizeof(LONG))
