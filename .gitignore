# Build outputs
/target/
/tools/*/target/
/userspace/*/target/
**/*.rs.bk

# Image artifacts (regenerated; not source)
*.img
!crates/kernel/ext4/tests/*.img
# kernel/blobs/rootfs-*.img is generated by `xtask rootfs` (ensured at build).
# vdso-*.so is assembled from vdso/*.S by vdso/build.sh (ensured at build).
kernel/blobs/*.so
*.iso
*.bin
# Generated by tools/mkutf8data/mkutf8data.py, but committed: nothing in the
# build regenerates it, so an ignored blob makes every fresh clone fail to
# compile `utf8`. `mkutf8data.py --check` re-derives it and fails on drift.
!crates/shared/utf8/data/utf8data.bin
*.elf
*.efi
*.zst
initramfs.cpio*
boot.img*

# Coverage
*.profraw
*.profdata
coverage/
lcov.info
*.gcda
*.gcno

# Debug symbols (split debuginfo)
*.dSYM/
*.pdb
debug-symbols/

# Vendored builds (re-buildable from source)
/userspace/libc/musl/build/
/userspace/dynlink/build/

# Built userspace binaries. Each userspace/<name>/<name> is the compiled
# output of <name>.c. Ignore everything under userspace/*/, then re-allow
# source files + the trees that are real source.
#
# This pattern assumes a FLAT userspace/<name>/<name>.c layout, so any nested
# tree must be re-allowed explicitly or it vanishes from `git add` without a
# warning — `userspace/probes` (the Rust probe workspace) is one, and the
# stale `userspace/dynlink/dynlink` binaries on main are what it looks like
# when the rule outlives its layout.
/userspace/*/*
!/userspace/*/*.c
!/userspace/*/*.h
!/userspace/*/*.rs
!/userspace/*/*.toml
!/userspace/*/*.service
!/userspace/*/Makefile
!/userspace/*/README*
!/userspace/shared/
!/userspace/shared/**
!/userspace/libc/
!/userspace/libc/**
!/userspace/keymaps/
!/userspace/keymaps/**
!/userspace/probes/
!/userspace/probes/**
/userspace/probes/target/

# QEMU runtime
/boot.txt
/output/
/qemu-*.log
/qemu-*.pcap
/serial-*.log
*.qcow2
*.raw

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.fleet/
.zed/
.helix/

# Claude Code local
.claude/settings.local.json
.claude/.cache/
.claude/scheduled_tasks.lock

# Direnv / local env
.envrc.local
.env
.env.local
.env.*.local

# Python virtualenvs (any tool that uses one)
.venv/
__pycache__/
*.pyc

# Node (if any tooling drags it in)
node_modules/
package-lock.json.bak

# Docker
.docker/
docker-compose.override.yml

# Soak runner working dirs (artifacts ARE committed; runtime is not)
/soak-runner-tmp/
/soak-runs/

# Bench harness scratch (final history IS committed)
/bench-tmp/
/bench-runs/

# OS-pkg scratch
*.deb
*.rpm
*.apk

# Crash dumps (anchored to repo root so they never match source modules
# named `core` — e.g. crates/kernel/tty/src/core.rs / core/ — which the
# un-anchored `core` / `core.*` patterns silently un-tracked, breaking CI).
/core
/core.*
*.core
vmcore*

# rust-analyzer / cargo cache
.rust-cache/
.cargo-cache/

# Per-user xtask scratch
/xtask-tmp/

# NOT ignored (commit these intentionally):
# /Cargo.lock              — binary project; lock kernel deps
# /targets/*.json          — target JSONs are source
# /link/*.ld               — linker scripts are source
# /docs/                   — specs are source
# /bench-history/          — perf-regression baselines per 40§6
# /soak-artifacts/         — signed soak artifacts per 40§3 (final, not runtime)
# /tools/docker/Dockerfile.* — image source
# /.github/workflows/*.yml — CI source
# /rust-toolchain.toml     — toolchain pin
crates/kernel/syscalls/vdso/*.so

# rustc incremental-compilation crash dumps (transient, never commit)
rustc-ice-*.txt
