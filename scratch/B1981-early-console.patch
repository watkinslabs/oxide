+    #[test]
+    fn boot_console_carries_output_emitted_before_the_primary_exists() {
+        let _g = lock_sink();
+        clear_byte_sink();
+        let _ = drain_sink();
+        let _ = drain_early();
+        register_boot_console(early_sink);
+        let _ = drain_early(); // discard the registration replay
+        write_raw(b"early-only-marker-A\n");
+        let early = drain_early();
+        unregister_boot_console();
+        assert!(contains(&early, b"early-only-marker-A"),
+                "boot console did not receive pre-primary output");
+        assert!(drain_sink().is_empty(), "primary sink was never installed");
+    }
+
+    #[test]
+    fn handover_neither_duplicates_nor_drops() {
+        let _g = lock_sink();
+        clear_byte_sink();
+        let _ = drain_sink();
+        let _ = drain_early();
+        register_boot_console(early_sink);
+        let _ = drain_early();
+        write_raw(b"pre-handover-marker-B\n");
+        assert!(contains(&drain_early(), b"pre-handover-marker-B"));
+
+        // The boot console is caught up, so the incoming primary must replay
+        // NOTHING — a duplicate here is the same line twice on one UART.
+        set_byte_sink(test_sink);
+        assert!(drain_sink().is_empty(), "handover replayed bytes the boot console already wrote");
+        assert!(!boot_console_registered(), "boot console outlived the primary it handed over to");
+
+        // ...and the boot console is gone, so post-handover output goes to the
+        // primary only.
