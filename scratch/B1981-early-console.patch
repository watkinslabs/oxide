+
+    static EARLY_BYTES: Mutex<alloc::vec::Vec<u8>> = Mutex::new(alloc::vec::Vec::new());
+    fn early_sink(bytes: &[u8]) {
+        EARLY_BYTES.lock().unwrap_or_else(|e| e.into_inner()).extend_from_slice(bytes);
+    }
+    fn drain_early() -> alloc::vec::Vec<u8> {
+        let mut g = EARLY_BYTES.lock().unwrap_or_else(|e| e.into_inner());
+        let out = g.clone();
+        g.clear();
+        out
+    }
+
+    fn contains(hay: &[u8], needle: &[u8]) -> bool {
+        hay.windows(needle.len()).any(|w| w == needle)
+    }
