# Bootloader + firmware binaries fetched by `tools/fetch-vendor.sh`.
# Not committed: keeps repo size down + sidesteps redistribution
# license-tracking. Run the fetch script (or `xtask vendor`) to
# populate.
*
!.gitignore
!README.md
# busybox vendored binaries: x86_64 already tracked; aarch64 added
# per F148 once the cross-toolchain landed.
!busybox/
!busybox/build.sh
!busybox/busybox
!busybox/busybox-aarch64
busybox/busybox-1.37.0/
# vendor/cross: README tracked, toolchain blobs ignored (~370 MB).
!cross/
!cross/README.md
cross/aarch64-linux-musl-cross/
# dhcpcd 10.3.2: per-arch static-musl binaries + build recipe tracked;
# source tree + tarball regenerated by tools/fetch-dhcpcd.sh.
!dhcpcd/
!dhcpcd/build.sh
!dhcpcd/dhcpcd-x86_64
!dhcpcd/dhcpcd-aarch64
# dropbear 2024.86: per-arch static-musl binaries + build recipe;
# source tree + tarball regenerated by tools/fetch-dropbear.sh.
!dropbear/
!dropbear/build.sh
!dropbear/dropbearmulti-x86_64
!dropbear/dropbearmulti-aarch64
# openssh-portable 9.9p2: per-arch static-musl binaries + build
# recipe; source tree + tarball regenerated by tools/fetch-openssh.sh.
# F210 — replaces dropbear (which has known PTY-with-closed-stdin
# behavior that loses shell output on `ssh -tt 'cmd'`).
!openssh/
!openssh/build.sh
!openssh/sshd-x86_64
!openssh/sshd-aarch64
!openssh/sshd-session-x86_64
!openssh/sshd-session-aarch64
!openssh/ssh-keygen-x86_64
!openssh/ssh-keygen-aarch64
!openssh/ssh-x86_64
!openssh/ssh-aarch64
# Linux-PAM 1.7.2: per-arch static libs + headers + build recipe
# tracked; source tree + tarball regenerated by tools/fetch-pam.sh.
!pam/
!pam/build.sh
!pam/install-x86_64/
!pam/install-x86_64/**
!pam/install-aarch64/
!pam/install-aarch64/**
pam/Linux-PAM-1.7.2/
pam/Linux-PAM-1.7.2.tar.xz
pam/Linux-PAM-1.5.3/
pam/Linux-PAM-1.5.3.tar.xz
# musl dynamic loader (ld-musl-<arch>.so.1) — F230.
# x86_64 from Fedora /lib/ld-musl-x86_64.so.1 (musl 1.2.5).
# aarch64 from vendor/cross/.../aarch64-linux-musl/lib/libc.so (musl 1.2.2-git).
!musl/
!musl/ld-musl-x86_64.so.1
!musl/ld-musl-aarch64.so.1
# zlib 1.3.1 — F229 vendored static for openssh compression.
!zlib/
!zlib/build.sh
!zlib/install-x86_64/
!zlib/install-x86_64/**
!zlib/install-aarch64/
!zlib/install-aarch64/**
zlib/zlib-1.3.1/
zlib/zlib-1.3.1.tar.gz
# GNU bash 5.2.37: per-arch static-musl binary + build recipe.
# F216 — first GNU userspace program; sets the pattern for further
# coreutils / util-linux / etc. cross-builds.
!bash/
!bash/build.sh
!bash/bash-x86_64
!bash/bash-aarch64
bash/bash-5.2.37/
bash/bash-5.2.37.tar.gz
bash/config.cache
# GNU sed 4.9 — F217.
!sed/
!sed/build.sh
!sed/sed-x86_64
!sed/sed-aarch64
sed/sed-4.9/
sed/sed-4.9.tar.xz
# GNU coreutils 8.32 — F218. Single-binary cross-build (102 applets).
!coreutils/
!coreutils/build.sh
!coreutils/coreutils-x86_64
!coreutils/coreutils-aarch64
coreutils/coreutils-8.32/
coreutils/coreutils-8.32.tar.xz
